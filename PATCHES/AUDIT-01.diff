+    return null;
+  }
+
+  const parsed = new Date(text);
+  if (Number.isNaN(parsed.getTime())) {
+    return null;
+  }
+
+  if (options.endOfDay && /^\d{4}-\d{2}-\d{2}$/.test(text)) {
