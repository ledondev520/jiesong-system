+  })();
+
+  inFlightGetRequests.set(cacheKey, requestPromise as Promise<unknown>);
+  try {
+    return cloneCachedData(await requestPromise);
+  } finally {
+    inFlightGetRequests.delete(cacheKey);
+  }
+};
