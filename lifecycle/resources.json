{
  "resources": [
    {
      "id": "customs-brokers",
      "routeFile": "backend/src/routes/system.js",
      "routes": ["POST /customs-brokers", "PUT /customs-brokers/:id"],
      "update": { "file": "backend/src/controllers/system/customsBrokerController.js", "handler": "updateCustomsBroker" },
      "matrix": {
        "path": "/api/v1/system/customs-brokers",
        "table": "customs_brokers",
        "create": { "name": "Synthetic matrix broker", "contact": "Original contact", "phone": "Original phone" },
        "edit": { "name": "Synthetic edited broker" },
        "invalid": [{ "name": "   ", "contact": "Unwanted contact" }, { "name": null, "phone": "Unwanted phone" }, { "isActive": "false" }],
        "blank": { "contact": "", "phone": "   " },
        "clear": { "contact": null, "phone": null },
        "clearStatus": 200,
        "filter": "Synthetic edited broker"
      }
    },
    {
      "id": "ports",
      "routeFile": "backend/src/routes/system.js",
      "routes": ["POST /ports", "PUT /ports/:id"],
      "update": { "file": "backend/src/controllers/system/portCategoryController.js", "handler": "updatePort" },
      "matrix": {
        "path": "/api/v1/system/ports",
        "table": "ports",
        "create": { "name": "Synthetic matrix port", "code": "SYN-MATRIX" },
        "edit": { "name": "Synthetic edited port", "code": "SYN-EDITED" },
        "invalid": [{ "name": "   ", "code": "UNWANTED" }, { "name": null, "code": "UNWANTED" }, { "name": "Unwanted name", "code": "   " }],
        "blank": { "isActive": "" },
        "clear": { "name": null },
        "clearStatus": 400,
        "filter": "Synthetic edited port"
      }
    },
    {
      "id": "quotes",
      "routeFile": "backend/src/routes/quotes.js",
      "routes": ["POST /", "PUT /:id"],
      "update": { "file": "backend/src/controllers/quoteController.js", "handler": "update" },
      "matrix": {
        "path": "/api/v1/quotes",
        "table": "quotes",
        "create": { "note": "Synthetic matrix quote", "paymentTerms": "Original terms" },
        "edit": { "note": "Synthetic edited quote" },
        "invalid": [{ "currency": "EUR" }, { "incoterm": "XYZ" }, { "status": "BOGUS" }, { "status": "SENT", "note": "mixed" }],
        "blank": { "paymentTerms": "   " },
        "clear": { "paymentTerms": null },
        "clearStatus": 200,
        "filter": "Synthetic edited quote"
      }
    },
    {
      "id": "customers",
      "routeFile": "backend/src/routes/customers.js",
      "routes": ["POST /", "PUT /:id"],
      "update": { "file": "backend/src/controllers/customerController.js", "handler": "update" },
      "matrix": {
        "path": "/api/v1/customers",
        "table": "customers",
        "create": { "name": "Synthetic matrix customer", "legalName": "Synthetic Original LLC", "defaultIncoterm": "FOB", "contactName": "Original contact" },
        "edit": { "name": "Synthetic edited customer", "legalName": "Synthetic Edited LLC", "country": "US" },
        "invalid": [
          { "name": "   ", "legalName": "Unwanted" },
          { "name": null, "legalName": "Unwanted" },
          { "isActive": "false" },
          { "defaultCurrency": "EUR" },
          { "country": "USA" }
        ],
        "blank": { "contactName": "", "contactPhone": "   " },
        "clear": { "contactName": null },
        "clearStatus": 200,
        "filter": "Synthetic edited customer"
      }
    },
    {
      "id": "sales-purchase-drafts",
      "kind": "action",
      "routeFile": "backend/src/routes/sales.js",
      "routes": ["POST /:id/purchase-drafts"],
      "test": "backend/src/integration/purchase-drafts.integration.js"
    },
    {
      "id": "supplier-hard-delete",
      "kind": "action",
      "routeFile": "backend/src/routes/suppliers.js",
      "routes": ["POST /:id/hard-delete"],
      "test": "backend/src/integration/mcp-rbac-deletes.integration.js"
    },
    {
      "id": "pricing-preview",
      "kind": "action",
      "routeFile": "backend/src/routes/pricing.js",
      "routes": ["POST /preview"],
      "test": "backend/src/integration/pricing-preview.integration.js"
    },
    {
      "id": "pricing-config",
      "kind": "singleton-config",
      "routeFile": "backend/src/routes/system.js",
      "routes": [
        "PUT /pricing-config"
      ],
      "update": {
        "file": "backend/src/controllers/system/pricingController.js",
        "handler": "updatePricing"
      },
      "matrix": {
        "adapter": "pricing-config-file",
        "path": "/api/v1/system/pricing-config",
        "initial": {
          "exchangeRate": 6.72,
          "exchangeAdjustment": -0.2,
          "defaultMarkup": 0.3,
          "categoryMarkups": []
        },
        "replace": {
          "exchangeRate": 7.1,
          "exchangeAdjustment": -0.1,
          "defaultMarkup": 0.25,
          "categoryMarkups": []
        },
        "invalid": [
          {},
          null,
          [],
          {
            "exchangeRate": 6.72
          },
          {
            "exchangeRate": 0,
            "exchangeAdjustment": -0.2,
            "defaultMarkup": 0.3,
            "categoryMarkups": []
          },
          {
            "exchangeRate": "6.72",
            "exchangeAdjustment": -0.2,
            "defaultMarkup": 0.3,
            "categoryMarkups": []
          },
          {
            "exchangeRate": 6.72001,
            "exchangeAdjustment": -0.2,
            "defaultMarkup": 0.3,
            "categoryMarkups": []
          },
          {
            "exchangeRate": 6.72,
            "exchangeAdjustment": -0.2,
            "defaultMarkup": 1.5,
            "categoryMarkups": []
          },
          {
            "exchangeRate": 6.72,
            "exchangeAdjustment": -0.2,
            "defaultMarkup": 0.3,
            "categoryMarkups": [],
            "roundUpTo": 0
          },
          {
            "exchangeRate": 6.72,
            "exchangeAdjustment": -0.2,
            "defaultMarkup": 0.3,
            "categoryMarkups": [],
            "roundUpTo": 1.5
          },
          {
            "exchangeRate": 6.72,
            "exchangeAdjustment": -0.2,
            "defaultMarkup": 0.3,
            "categoryMarkups": [
              {
                "categoryId": "x",
                "categoryName": "x",
                "markup": 2
              }
            ]
          },
          {
            "exchangeRate": 0.1,
            "exchangeAdjustment": -0.2,
            "defaultMarkup": 0.3,
            "categoryMarkups": []
          },
          {
            "exchangeRate": 6.72,
            "exchangeAdjustment": -0.2,
            "defaultMarkup": 0.3,
            "categoryMarkups": [],
            "roundUpTo": 1,
            "unknown": 1
          }
        ]
      }
    }
  ],
  "lists": [
