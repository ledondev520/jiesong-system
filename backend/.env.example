# JWT 配置
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 数据库 (PostgreSQL)
DATABASE_URL=postgresql://jiesong:jiesong_pass@localhost:5432/jiesong?schema=public

# 服务器
PORT=3001
NODE_ENV=production
# Default empty: forwarding headers are not trusted. Set only after verifying the actual proxy chain.
# For a verified same-host Nginx proxy: 127.0.0.1/32,::1/128. Never use true, a hop count, or /0.
TRUSTED_PROXY_CIDRS=

# Kimi API
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# 活动 AI：kimi 或 deepseek；密钥仅在本地 .env / 部署 secret manager 中配置
AI_PROVIDER=kimi
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# CORS
CORS_ORIGIN=http://localhost:3000

# 文件上传
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10mb
