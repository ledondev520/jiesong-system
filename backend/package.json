{
  "name": "jiesong-backend",
  "version": "1.0.0",
  "description": "捷淞进销存系统后端API服务",
  "main": "src/app.js",
  "bin": {
    "jiesong": "./src/agent/cli/index.js"
  },
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "agent:cli": "node ./src/agent/cli/index.js",
    "agent:mcp": "node ./src/agent/mcp/server.js",
    "wechat-group:doctor": "node ./src/agent/wechat-group/index.js doctor",
    "wechat-group:start": "node ./src/agent/wechat-group/index.js start",
    "wechat-group:status": "node ./src/agent/wechat-group/index.js status",
    "wechat-group:stop": "node ./src/agent/wechat-group/index.js stop",
    "invoice:verify": "node ../scripts/verify_tax_refund_invoices.js",
    "test": "NODE_ENV=test JWT_SECRET=test-only-jwt-secret-for-ci-123456 node --test",
    "test:wechat-group": "NODE_ENV=test JWT_SECRET=test-only-jwt-secret-for-ci-123456 node --test src/integrations/wechatGroupAgent/wechatGroupAgent.test.js",
    "test:db": "NODE_ENV=test JWT_SECRET=test-only-jwt-secret-for-ci-123456 node --test src/integration/database.integration.js",
    "test:all": "npm run test && npm run test:db",
    "db:backup": "node scripts/db-backup.js",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/db-backup.js && prisma migrate dev",
    "db:migrate:doctor": "node scripts/doctor-prisma-migrations.js",
    "db:migrate:repair": "node scripts/db-backup.js && node scripts/repair-prisma-migration-state.js",
    "db:push": "node scripts/db-backup.js && prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@codeany/open-agent-sdk": "^0.1.0",
    "@prisma/client": "^5.8.0",
    "adm-zip": "^0.5.16",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "docx-templates": "^4.15.0",
    "docxtemplater": "^3.67.6",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.16.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^6.1.200",
    "pdfkit": "^0.16.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pizzip": "^3.2.0",
    "prom-client": "^15.1.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "^5.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "捷淞国际物流",
  "license": "MIT",
  "knip": {
    "entry": [
      "src/app.js",
      "src/routes/*.js",
      "src/controllers/**/*.js",
      "src/middleware/*.js",
      "src/agent/**/*.js"
    ],
    "ignore": [
      "**/*.test.js",
      "prisma/migrations/**",
      "prisma/fix-*.js",
      "prisma/import-*.js",
      "prisma/seed_*.js",
      "scripts/*.js"
    ]
  }
}
