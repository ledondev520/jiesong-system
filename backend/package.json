{
  "name": "jiesong-backend",
  "version": "1.0.0",
  "description": "捷淞进销存系统后端API服务",
  "main": "src/app.js",
  "bin": {
    "jiesong": "./src/agent/cli/index.js"
  },
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "agent:cli": "node ./src/agent/cli/index.js",
    "agent:mcp": "node ./src/agent/mcp/server.js",
    "wechat-group:doctor": "node ./src/agent/wechat-group/index.js doctor",
    "wechat-group:start": "node ./src/agent/wechat-group/index.js start",
    "wechat-group:status": "node ./src/agent/wechat-group/index.js status",
    "wechat-group:stop": "node ./src/agent/wechat-group/index.js stop",
    "invoice:verify": "node ../scripts/verify_tax_refund_invoices.js",
    "test": "node ../scripts/check-lifecycle.cjs && NODE_ENV=test JWT_SECRET=test-only-jwt-secret-for-ci-123456 node --test",
    "test:wechat-group": "NODE_ENV=test JWT_SECRET=test-only-jwt-secret-for-ci-123456 node --test src/integrations/wechatGroupAgent/wechatGroupAgent.test.js",
    "test:db": "NODE_ENV=test JWT_SECRET=test-only-jwt-secret-for-ci-123456 node --test src/integration/database.integration.js src/integration/trade-lifecycle.integration.js src/integration/procurement-lifecycle.integration.js src/integration/purchase-batch-import.integration.js src/integration/sales-cargo-lifecycle.integration.js src/integration/sales-creation.integration.js src/integration/password-recovery.integration.js src/integration/store-first-use.integration.js src/integration/browser-session.integration.js src/integration/warehouse-exceptions.integration.js src/integration/sales-role-exceptions.integration.js src/integration/purchase-receipt-exceptions.integration.js src/integration/sales-transition-races.integration.js src/integration/received-purchase-edits.integration.js src/integration/contract-attachments.integration.js src/integration/supplier-editor.integration.js src/integration/finance-query-boundaries.integration.js src/integration/sales-partial-metadata.integration.js src/integration/receivable-allocation.integration.js src/integration/bank-import-lifecycle.integration.js src/integration/invoice-linkage-boundaries.integration.js src/integration/catalog-form-lifecycle.integration.js src/integration/notification-state-lifecycle.integration.js src/integration/generic-export-content.integration.js src/integration/tax-preparation-content.integration.js src/integration/purchase-excel-import.integration.js src/integration/financial-snapshot-readbacks.integration.js src/integration/financial-workbook-import.integration.js src/integration/overview-source-readbacks.integration.js src/integration/financial-library-source-readbacks.integration.js src/integration/financial-evidence-transfer.integration.js src/integration/application-audit-readback.integration.js src/integration/ordinary-setting-text.integration.js src/integration/email-registration-http.integration.js src/integration/resource-lifecycle.integration.js src/integration/financial-cli-safety.integration.js src/integration/quote-lifecycle.integration.js src/integration/schema-drift.integration.js src/integration/backfill-default-customer.integration.js src/integration/customers.integration.js src/integration/purchase-drafts.integration.js src/integration/pricing-preview.integration.js src/integration/order-creation-terms.integration.js src/integration/payables-one-basis.integration.js src/integration/dashboard-todos.integration.js src/integration/company-settings.integration.js src/integration/seller-identity.integration.js src/integration/invoice-title-migration.integration.js src/integration/archive-test-data.integration.js src/integration/sales-customer-rules.integration.js src/integration/archive-test-data-safety.integration.js src/integration/mcp-rbac-deletes.integration.js src/integration/agent-pending-actions.integration.js src/integration/sqlite-wal-concurrency.integration.js src/integration/customs-maintenance.integration.js",
    "test:carrier-pdf": "NODE_ENV=test JWT_SECRET=test-only-jwt-secret-for-ci-123456 node --test src/integration/carrier-pdf-edges.integration.js",
    "test:all": "npm run test && npm run test:db && npm run test:carrier-pdf",
    "db:backup": "node scripts/db-backup.js",
    "db:restore": "node scripts/db-restore.js",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/db-backup.js && prisma migrate dev",
    "db:migrate:doctor": "node scripts/doctor-prisma-migrations.js",
    "db:migrate:repair": "node scripts/db-backup.js && node scripts/repair-prisma-migration-state.js",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@codeany/open-agent-sdk": "0.2.4",
    "@prisma/client": "^5.8.0",
    "adm-zip": "^0.5.16",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "8.7.0",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "multer": "^2.5.0",
    "openai": "^6.16.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "5.4.624",
    "pdfkit": "^0.16.0",
    "saxes": "^5.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "nodemon": "^3.0.2",
    "prisma": "^5.8.0"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "author": "捷淞国际物流",
  "license": "MIT",
  "knip": {
    "entry": [
      "src/app.js",
      "src/routes/*.js",
      "src/controllers/**/*.js",
      "src/middleware/*.js",
      "src/agent/**/*.js"
    ],
    "ignore": [
      "**/*.test.js",
      "prisma/migrations/**",
      "prisma/fix-*.js",
      "prisma/import-*.js",
      "prisma/seed_*.js",
      "scripts/*.js"
    ]
  }
}
