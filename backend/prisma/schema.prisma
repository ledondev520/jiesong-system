// Input: 数据库设计文档 (docs/数据库设计.md)
// Output: Prisma ORM 数据模型定义
// Pos: 数据层核心Schema，定义所有实体及关系
// Note: 我被更新时，必须同步更新本头注释 + 所属目录 README/INDEX。
// 
// 2026-01-20 重构：合并货柜与出口合同，用 EXP 号作为货柜标识
// 2026-02-21 迁移：SQLite → Supabase (PostgreSQL)
// 2026-06-03 新增：SalesContractFile 归档出口合同/装箱/报关源文件附件

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")   // 本地开发默认使用 SQLite（file:./dev.db）
}

// Role 类型说明 (SQLite 不支持枚举，使用 String):
// - ADMIN: 管理员
// - PURCHASE: 采购
// - SALES: 销售
// - FINANCE: 财务
// - WAREHOUSE: 仓库

// ==================== 用户与权限 ====================

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  password      String
  name          String
  role          String    @default("SALES") // ADMIN, PURCHASE, SALES, FINANCE, WAREHOUSE
  email         String?
  phone         String?
  avatar        String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  operationLogs OperationLog[]
  chatHistories ChatHistory[]
  agentReplaySummaries AgentReplaySummary[]
  notifications Notification[]

  @@map("users")
}

model AgentAccount {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  status      String   @default("ACTIVE")
  defaultMode String   @default("READ_INGEST")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  credentials   AgentCredential[]
  grants        AgentGrant[]
  operationLogs OperationLog[]

  @@map("agent_accounts")
}

model AgentCredential {
  id               String   @id @default(cuid())
  agentAccountId   String
  credentialKey    String   @unique
  label            String?
  secretHash       String
  secretPreview    String?
  status           String   @default("ACTIVE")
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime @default(now())
  revokedAt        DateTime?

  agentAccount   AgentAccount   @relation(fields: [agentAccountId], references: [id], onDelete: Cascade)
  grants         AgentGrant[]
  operationLogs  OperationLog[]

  @@index([agentAccountId, status])
  @@map("agent_credentials")
}

model AgentGrant {
  id                String   @id @default(cuid())
  agentAccountId    String
  agentCredentialId String?
  resource          String
  action            String
  scopeJson         String?
  createdAt         DateTime @default(now())

  agentAccount    AgentAccount    @relation(fields: [agentAccountId], references: [id], onDelete: Cascade)
  agentCredential AgentCredential? @relation(fields: [agentCredentialId], references: [id], onDelete: Cascade)

  @@unique([agentAccountId, agentCredentialId, resource, action])
  @@index([agentAccountId, resource, action])
  @@map("agent_grants")
}

// ==================== 基础数据 ====================

model Port {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores         Store[]
  salesContracts SalesContract[]

  @@map("ports")
}

model Supplier {
  id              String    @id @default(cuid())
  name            String    // 供应商全称（合同用）
  shortName       String?   // 简称
  // 联系人信息
  contactName     String?
  contactPhone    String?
  contactEmail    String?
  // 公司信息（合同用）
  address         String?   // 公司地址
  phone           String?   // 公司电话
  taxId           String?   // 纳税人识别号/税号
  bankName        String?   // 开户银行名称
  bankAccount     String?   // 银行账号
  // 状态
  hasQualityIssue Boolean   @default(false)
  qualityNote     String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  aliases           SupplierAlias[]
  purchaseContracts PurchaseContract[]
  products          ProductSupplier[]

  @@map("suppliers")
}

model SupplierAlias {
  id         String   @id @default(cuid())
  alias      String   @unique
  supplierId String
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@map("supplier_aliases")
}

model Store {
  id           String   @id @default(cuid())
  name         String   @unique
  portId       String
  contactName  String?
  contactPhone String?
  contactEmail String?
  address      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  port         Port          @relation(fields: [portId], references: [id])
  salesItems   SalesItem[]
  packingItems PackingItem[]

  @@map("stores")
}

model Product {
  id            String   @id @default(cuid())
  customsName   String
  description   String?
  specification String?  // 原文本规格（兼容历史数据）
  unit          String?
  lowStockThreshold Float @default(0)
  categoryId    String?
  // 海关申报信息
  hsCode        String?  // HS编码（10位海关编码）
  declaration   String?  // 申报要素（汇总）
  // 重量信息
  grossWeight   Float?   // 毛重 (kg/件)
  netWeight     Float?   // 净重 (kg/件)
  volume        Float?   // 体积 (CBM/件)
  packingSpec   String?  // 包装规格 (如: 4片/箱)
  // 尺寸信息（用于3D可视化）
  length        Float?   // 长度 (mm)
  width         Float?   // 宽度 (mm)
  height        Float?   // 高度 (mm)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  suppliers      ProductSupplier[]
  purchaseItems  PurchaseItem[]
  salesItems     SalesItem[]
  inventories    Inventory[]
  packingItems   PackingItem[]
  customsDeclarationItems CustomsDeclarationItem[]
  priceHistories PriceHistory[]
  taxRates       TaxRate[]

  @@map("products")
}

model ProductCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]

  @@map("product_categories")
}

model CustomsBroker {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customs_brokers")
}

model ProductSupplier {
  id         String   @id @default(cuid())
  productId  String
  supplierId String
  price      Float?
  updatedAt  DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model PriceHistory {
  id         String   @id @default(cuid())
  productId  String
  supplierId String?
  price      Float
  recordedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@map("price_histories")
}

// ==================== 采购管理 ====================

model PurchaseContract {
  id           String   @id @default(cuid())
  contractNo   String   @unique
  supplierId   String
  totalAmount  Float    @default(0)
  paidAmount   Float    @default(0)
  taxRate      Int      @default(13)  // 税率（%），通常为 1 或 13
  status       String   @default("DRAFT")
  signedAt     DateTime?
  expectedDate DateTime?
  invoiceNo    String?
  storeName    String?  // 发货店铺名称
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier Supplier         @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]
  payments Payment[]
  files    ContractFile[]

  @@index([status])
  @@index([supplierId])
  @@index([createdAt])
  @@map("purchase_contracts")
}

model PurchaseItem {
  id                 String   @id @default(cuid())
  purchaseContractId String
  productId          String
  quantity           Float
  unit               String?
  unitPrice          Float
  totalPrice         Float
  specification      String?
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  purchaseContract PurchaseContract @relation(fields: [purchaseContractId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id])
  inventories      Inventory[]

  @@index([purchaseContractId])
  @@index([productId])
  @@map("purchase_items")
}

// ==================== 销售管理（含货柜/装箱） ====================
// 重构说明：一个出口合同 EXP = 一个货柜，合并管理

model SalesContract {
  id             String   @id @default(cuid())
  contractNo     String   @unique  // EXP 编号，同时作为货柜标识
  // 销售信息
  totalAmount    Float    @default(0)
  receivedAmount Float    @default(0)
  exchangeRate   Float
  status         String   @default("DRAFT")  // DRAFT/CONFIRMED/PACKING/SHIPPED/ARRIVED/COMPLETED
  signedAt       DateTime?
  note           String?
  // 货柜信息（合并自原 Container 表）
  portId         String?  // 目的港口
  totalBoxes     Int      @default(0)
  grossWeight    Float    @default(0)
  netWeight      Float    @default(0)
  volume         Float    @default(0)
  shippedAt      DateTime?
  estimatedArrival DateTime?
  customsBroker  String?
  isFumigated    Boolean?
  hasTaxRefund   Boolean?
  containerLabel String?  // 物理货柜编号（如 "02-振宗"），与 EXP 合同号区分
  // 时间戳
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  port         Port?         @relation(fields: [portId], references: [id])
  customsDeclarations CustomsDeclaration[]
  forexVerifications ForexVerification[]
  items        SalesItem[]
  packingItems PackingItem[] // 装箱明细
  payments     Payment[]
  inventories  Inventory[]
  taxRefunds   TaxRefund[]
  files        SalesContractFile[]

  @@index([status])
  @@index([portId])
  @@index([createdAt])
  @@map("sales_contracts")
}

model SalesItem {
  id              String   @id @default(cuid())
  salesContractId String
  productId       String
  storeId         String
  quantity        Float
  unit            String?
  costPrice       Float
  sellingPrice    Float
  specification   String?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  salesContract SalesContract @relation(fields: [salesContractId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  store         Store         @relation(fields: [storeId], references: [id])
  inventories   Inventory[]

  @@index([salesContractId])
  @@index([productId])
  @@map("sales_items")
}

// 装箱明细（原 ContainerItem，现关联 SalesContract）
model PackingItem {
  id              String   @id @default(cuid())
  salesContractId String   // 关联出口合同（即货柜）
  productId       String
  storeId         String?
  isOwnedByJiesong Boolean @default(true)
  sourceParty     String?
  quantity        Float
  unit            String?
  boxes           Int?
  grossWeight     Float?
  netWeight       Float?
  volume          Float?
  // 价格信息（USD）
  unitPrice       Float?   // 单价（USD）
  totalPrice      Float?   // 总价（USD）= 单价 * 数量
  // 商品详情（来自出货清单）
  supplement      String?  // 商品补充信息（如型号、颜色、用途等）
  specification   String?  // 规格/尺寸（如 "510*510*810"）
  manufacturer    String?  // 厂家名称
  invoiceNo       String?  // 发票号码（增值税发票，退税核销用）
  purchaseContractNo String? // 购销合同号（对应采购合同）
  purchaseCost    Float?   // 采购金额（人民币）
  hsMatchConfidence Float? // HS编码匹配置信度（0-100）
  hsMatchMethod   String?  // HS编码匹配方式（精确/别名/模糊等）
  // 商品规格尺寸（用于3D可视化，单位 mm）
  length          Float?   // 长度 (mm)
  width           Float?   // 宽度 (mm)
  height          Float?   // 高度 (mm)
  // 3D 装箱位置（由装箱算法计算）
  posX            Float?   // 在货柜中的 X 位置 (mm)
  posY            Float?   // 在货柜中的 Y 位置 (mm)
  posZ            Float?   // 在货柜中的 Z 位置 (mm)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  salesContract SalesContract @relation(fields: [salesContractId], references: [id], onDelete: Cascade)
  customsDeclarationItems CustomsDeclarationItem[]
  product       Product       @relation(fields: [productId], references: [id])
  store         Store?        @relation(fields: [storeId], references: [id])

  @@map("packing_items")
}

// ==================== 库存管理 ====================

model Inventory {
  id              String    @id @default(cuid())
  productId       String
  purchaseItemId  String?
  salesItemId     String?
  salesContractId String?   // 关联出口合同（代替原 containerId）
  quantity        Float
  unit            String?
  status          String    @default("PRODUCING")
  inboundAt       DateTime?
  outboundAt      DateTime?
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product       Product        @relation(fields: [productId], references: [id])
  purchaseItem  PurchaseItem?  @relation(fields: [purchaseItemId], references: [id])
  salesItem     SalesItem?     @relation(fields: [salesItemId], references: [id])
  salesContract SalesContract? @relation(fields: [salesContractId], references: [id])

  @@index([status])
  @@index([productId])
  @@index([salesContractId])
  @@index([createdAt])
  @@map("inventories")
}

// ==================== 财务管理 ====================

model Payment {
  id                 String   @id @default(cuid())
  idempotencyKey     String?  @unique
  type               String
  purchaseContractId String?
  salesContractId    String?
  sourcePaymentId    String?
  customerName       String?
  amount             Float
  currency           String   @default("CNY")
  paymentMethod      String?
  paymentDate        DateTime
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  purchaseContract PurchaseContract? @relation(fields: [purchaseContractId], references: [id])
  salesContract    SalesContract?    @relation(fields: [salesContractId], references: [id])
  sourcePayment    Payment?          @relation("PaymentAllocations", fields: [sourcePaymentId], references: [id])
  allocations      Payment[]         @relation("PaymentAllocations")

  @@index([sourcePaymentId])
  @@index([customerName])
  @@index([type])
  @@index([purchaseContractId])
  @@index([salesContractId])
  @@index([createdAt])
  @@map("payments")
}

// ==================== 出口退税 ====================

model CustomsDeclaration {
  id             String   @id @default(cuid())
  declarationNo  String   @unique
  salesContractId String
  declaredAt     DateTime?
  exportDate     DateTime?
  customsBroker  String?
  currency       String   @default("USD")
  exchangeRate   Float?
  totalAmount    Float    @default(0)
  totalQuantity  Float    @default(0)
  totalNetWeight Float    @default(0)
  totalGrossWeight Float  @default(0)
  status         String   @default("DRAFT") // DRAFT/DECLARED/RELEASED/VOID
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  salesContract      SalesContract            @relation(fields: [salesContractId], references: [id], onDelete: Cascade)
  items              CustomsDeclarationItem[]
  forexVerifications ForexVerification[]
  taxRefunds         TaxRefund[]

  @@index([salesContractId])
  @@map("customs_declarations")
}

model CustomsDeclarationItem {
  id                 String   @id @default(cuid())
  customsDeclarationId String
  productId          String
  packingItemId      String?
  taxRateId          String?
  itemNo             Int?
  customsName        String
  hsCode             String?
  declarationElements String?
  quantity           Float
  unit               String?
  unitPrice          Float?
  totalPrice         Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customsDeclaration CustomsDeclaration @relation(fields: [customsDeclarationId], references: [id], onDelete: Cascade)
  product            Product            @relation(fields: [productId], references: [id])
  packingItem        PackingItem?       @relation(fields: [packingItemId], references: [id])
  taxRate            TaxRate?           @relation(fields: [taxRateId], references: [id])

  @@index([customsDeclarationId])
  @@index([productId])
  @@index([packingItemId])
  @@index([taxRateId])
  @@map("customs_declaration_items")
}

model ForexVerification {
  id                  String   @id @default(cuid())
  verificationNo      String   @unique
  salesContractId     String
  customsDeclarationId String?
  bankName            String?
  currency            String   @default("USD")
  receivedAmount      Float
  settledAmount       Float?
  exchangeRate        Float?
  verifiedAt          DateTime?
  status              String   @default("PENDING") // PENDING/VERIFIED/FAILED
  note                String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  salesContract      SalesContract       @relation(fields: [salesContractId], references: [id], onDelete: Cascade)
  customsDeclaration CustomsDeclaration? @relation(fields: [customsDeclarationId], references: [id])
  taxRefunds         TaxRefund[]

  @@index([salesContractId])
  @@index([customsDeclarationId])
  @@map("forex_verifications")
}

model TaxRefund {
  id                  String   @id @default(cuid())
  refundNo            String   @unique
  salesContractId     String
  customsDeclarationId String
  forexVerificationId String?
  relation_no         String?
  invoice_no          String?
  vat_rate_type       Int?
  match_status        String   @default("pending") // pending/passed/blocked
  status              String   @default("DRAFT") // DRAFT/APPLIED/APPROVED/REFUNDED/REJECTED
  declaredAmount      Float    @default(0)
  refundableAmount    Float    @default(0)
  refundedAmount      Float    @default(0)
  appliedAt           DateTime?
  refundedAt          DateTime?
  note                String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  salesContract      SalesContract      @relation(fields: [salesContractId], references: [id], onDelete: Cascade)
  customsDeclaration CustomsDeclaration @relation(fields: [customsDeclarationId], references: [id])
  forexVerification  ForexVerification? @relation(fields: [forexVerificationId], references: [id])

  @@index([salesContractId])
  @@index([customsDeclarationId])
  @@index([forexVerificationId])
  @@map("tax_refunds")
}

model TaxRate {
  id              String   @id @default(cuid())
  productId       String
  hsCode          String?
  purchaseTaxRate Float    @default(13)
  refundRate      Float
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  isActive        Boolean  @default(true)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product                 Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customsDeclarationItems CustomsDeclarationItem[]

  @@index([productId, isActive])
  @@unique([productId, effectiveFrom])
  @@map("tax_rates")
}

model HsCode {
  id                    String   @id @default(cuid())
  hsCode                String   @unique
  productName           String
  taxRate               Float
  refundRate            Float?
  exportTaxRate         Float?
  vatRate               Float?
  unit                  String?
  note                  String?
  title                 String?
  sourceUrl             String?
  declarationElements   String?
  supervisionConditions String?
  inspectionQuarantine  String?
  chapterHierarchyJson  String?
  ciqCodesJson          String?
  agreementRatesJson    String?
  rcepRatesJson         String?
  basicInfoJson         String?
  taxInfoJson           String?
  rawPayloadJson        String?
  fetchedAt             DateTime?
  effectiveDate         DateTime

  @@index([productName])
  @@map("hs_codes")
}

// ==================== 文件管理 ====================

model ContractFile {
  id                 String   @id @default(cuid())
  purchaseContractId String
  fileName           String
  filePath           String
  fileType           String
  mimeType           String   @default("")
  fileSize           Int
  description        String?
  uploadedAt         DateTime @default(now())

  purchaseContract PurchaseContract @relation(fields: [purchaseContractId], references: [id], onDelete: Cascade)

  @@map("contract_files")
}

model SalesContractFile {
  id              String   @id @default(cuid())
  salesContractId String
  fileName        String
  filePath        String
  fileType        String
  mimeType        String   @default("")
  fileSize        Int
  description     String?
  uploadedAt      DateTime @default(now())

  salesContract SalesContract @relation(fields: [salesContractId], references: [id], onDelete: Cascade)

  @@index([salesContractId])
  @@map("sales_contract_files")
}

// ==================== AI与日志 ====================

model ChatHistory {
  id           String   @id @default(cuid())
  userId       String
  sessionId    String
  role         String
  content      String
  imageUrl     String?
  metadata     String?
  promptTokens Int?
  outputTokens Int?
  modelUsed    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, sessionId])
  @@map("chat_histories")
}

model TokenUsage {
  id             String   @id @default(cuid())
  userId         String
  sessionId      String?
  model          String
  promptTokens   Int
  outputTokens   Int
  totalTokens    Int
  requestType    String
  /// 无会话类调用的可选输出快照（如 HS 推荐原文），便于用量页「详情」展示
  detailSnapshot String?
  /// 用户输入摘要（如 HS 推荐的产品描述），便于用量列表首列展示
  promptBrief    String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("token_usages")
}

model OperationLog {
  id                String   @id @default(cuid())
  actorType         String   @default("USER")
  userId            String?
  agentAccountId    String?
  agentCredentialId String?
  requestId         String?
  idempotencyKey    String?
  action            String
  entity            String
  entityId          String?
  oldValue          String?
  newValue          String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime @default(now())

  user            User?            @relation(fields: [userId], references: [id])
  agentAccount    AgentAccount?    @relation(fields: [agentAccountId], references: [id])
  agentCredential AgentCredential? @relation(fields: [agentCredentialId], references: [id])

  @@index([userId])
  @@index([actorType])
  @@index([agentAccountId])
  @@index([agentCredentialId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("operation_logs")
}

model AgentReplaySummary {
  id           String   @id @default(cuid())
  userId       String
  sessionId    String
  source       String
  level        String
  summaryJson  String
  countsJson   String
  evidenceJson String
  profileJson  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, sessionId])
  @@index([sessionId])
  @@index([updatedAt])
  @@map("agent_replay_summaries")
}

// ==================== 系统配置 ====================

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  note      String?
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

// ==================== 通知 ====================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // PURCHASE_DRAFT, SALES_DRAFT, OVERDUE_RECEIVABLE, LOW_STOCK
  title     String
  content   String?
  link      String?  // 点击跳转的URL
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// ==================== 财务报表 ====================

model FinancialPeriod {
  id          String   @id @default(cuid())
  year        Int      // 会计年度，如 2025
  month       Int      // 账期月份 1-12
  periodLabel String   // 显示标签，如 "2025年1账期"
  reportDate  DateTime // 期末日期，如 2025-01-31
  importedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  balanceSheet     BalanceSheetEntry?
  incomeStatement  IncomeStatementEntry?

  @@unique([year, month])
  @@map("financial_periods")
}

model BalanceSheetEntry {
  id       String @id @default(cuid())
  periodId String @unique

  // 流动资产
  cashAndEquivalents   Float? // 货币资金 行次1
  shortTermInvestments Float? // 短期投资 行次2
  accountsReceivable   Float? // 应收账款 行次4
  prepaidExpenses      Float? // 预付账款 行次5
  otherReceivables     Float? // 其他应收款 行次8
  inventory            Float? // 存货 行次9
  totalCurrentAssets   Float? // 流动资产合计 行次15

  // 非流动资产
  totalNonCurrentAssets Float? // 非流动资产合计 行次29
  totalAssets           Float? // 资产合计 行次30

  // 流动负债
  accountsPayable            Float? // 应付账款 行次33
  advancedReceipts           Float? // 预收账款 行次34
  staffWagesPayable          Float? // 应付职工薪酬 行次35
  taxesPayable               Float? // 应交税费 行次36
  otherPayables              Float? // 其他应付款 行次39
  totalCurrentLiabilities    Float? // 流动负债合计 行次41

  // 非流动负债
  totalNonCurrentLiabilities Float? // 非流动负债合计 行次46
  totalLiabilities            Float? // 负债合计 行次47

  // 所有者权益
  paidInCapital    Float? // 实收资本 行次48
  capitalReserve   Float? // 资本公积 行次49
  surplusReserve   Float? // 盈余公积 行次50
  retainedEarnings Float? // 未分配利润 行次51
  totalEquity      Float? // 所有者权益合计 行次52

  period FinancialPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@map("balance_sheet_entries")
}

model IncomeStatementEntry {
  id       String @id @default(cuid())
  periodId String @unique

  // 本月金额
  revenueMonth             Float? // 营业收入 行次1
  costOfSalesMonth         Float? // 营业成本 行次2
  taxesMonth               Float? // 税金及附加 行次3
  sellingExpensesMonth     Float? // 销售费用 行次11
  adminExpensesMonth       Float? // 管理费用 行次14
  financialExpensesMonth   Float? // 财务费用 行次18
  investmentIncomeMonth    Float? // 投资收益 行次20
  operatingProfitMonth     Float? // 营业利润 行次21
  nonOperatingIncomeMonth  Float? // 营业外收入 行次22
  nonOperatingExpensesMonth Float? // 营业外支出 行次24
  totalProfitMonth         Float? // 利润总额 行次30
  incomeTaxMonth           Float? // 所得税费用 行次31
  netProfitMonth           Float? // 净利润 行次32

  // 本年累计金额
  revenueYTD             Float? // 营业收入
  costOfSalesYTD         Float? // 营业成本
  taxesYTD               Float? // 税金及附加
  sellingExpensesYTD     Float? // 销售费用
  adminExpensesYTD       Float? // 管理费用
  financialExpensesYTD   Float? // 财务费用
  investmentIncomeYTD    Float? // 投资收益
  operatingProfitYTD     Float? // 营业利润
  nonOperatingIncomeYTD  Float? // 营业外收入
  nonOperatingExpensesYTD Float? // 营业外支出
  totalProfitYTD         Float? // 利润总额
  incomeTaxYTD           Float? // 所得税费用
  netProfitYTD           Float? // 净利润

  period FinancialPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@map("income_statement_entries")
}

// ==================== 合同模板 ====================

model ContractTemplate {
  id          String   @id @default(cuid())
  name        String
  type        String   // PURCHASE / SALES
  supplierId  String?
  taxRate     Int?
  note        String?
  items       String   // JSON 字符串，存储商品明细模板
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([createdBy])
  @@map("contract_templates")
}

// ==================== 数据导入 ====================

model ImportRecord {
  id          String   @id @default(cuid())
  fileName    String
  totalRows   Int
  successRows Int
  failedRows  Int
  status      String
  errorLog    String?
  importedAt  DateTime @default(now())
  importedBy  String

  @@map("import_records")
}

// ==================== 银行流水与发票原始数据 ====================

model FinanceDataBatch {
  id            String   @id @default(cuid())
  type          String   // BANK_FLOW | INVOICE
  fileName      String
  recordCount   Int
  dataStartDate String?  // 数据覆盖起始日期 yyyy-MM-dd
  dataEndDate   String?  // 数据覆盖结束日期 yyyy-MM-dd
  note          String?
  importedAt    DateTime @default(now())

  bankTransactions BankTransaction[]
  invoiceRecords   InvoiceRecord[]

  @@map("finance_data_batches")
}

model BankTransaction {
  id                  String   @id @default(cuid())
  batchId             String
  txnTime             String   // 交易时间（原始字符串，保留精度）
  txnDate             String   // 交易日期 yyyy-MM-dd（用于筛选）
  amount              Float    // 正=收入，负=支出
  payer               String?  // 付方名称
  payee               String?  // 收方名称
  summary             String?  // 摘要
  txnType             String?  // 交易类型
  txnId               String?  // 交易流水号
  balance             Float?   // 余额
  counterpart         String?  // 对方名称（付/收方中非本公司的一方）
  direction           String   // IN | OUT
  // 智能关联引擎字段
  matchedContractId   String?
  matchedContractType String?  // PURCHASE / SALES
  matchScore          Float?
  matchStatus         String   @default("PENDING") // PENDING / MATCHED / IGNORED
  matchedAt           DateTime?
  createdAt           DateTime @default(now())

  batch FinanceDataBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([txnDate])
  @@index([counterpart])
  @@index([direction])
  @@index([matchStatus])
  @@index([matchedContractId])
  @@map("bank_transactions")
}

model InvoiceRecord {
  id                  String   @id @default(cuid())
  batchId             String
  invNo               String?  // 数电发票号码或发票号码
  invCode             String?  // 发票代码
  seller              String   // 销方名称
  sellerTaxId         String?  // 销方识别号
  buyer               String?  // 购方名称
  buyerTaxId          String?  // 购方识别号
  invDate             String   // 开票日期 yyyy-MM-dd
  invDateFull         String?  // 开票日期原始（含时分秒）
  itemName            String?  // 货物或应税劳务名称
  spec                String?  // 规格型号
  unit                String?  // 单位
  qty                 Float?   // 数量
  unitPrice           Float?   // 单价
  amount              Float    // 不含税金额
  taxRate             String?  // 税率
  tax                 Float    // 税额
  total               Float    // 价税合计
  invoiceType         String?  // 发票票种
  status              String   // 发票状态：正常、已红冲-全额等
  isPositive          String   // 是否正数发票：是/否
  riskLevel           String?  // 发票风险等级
  issuer              String?  // 开票人
  remark              String?  // 备注
  taxClassCode        String?  // 税收分类编码
  // 智能关联引擎字段
  matchedContractId   String?
  matchedContractType String?  // PURCHASE / SALES
  matchScore          Float?
  matchStatus         String   @default("PENDING") // PENDING / MATCHED / IGNORED
  matchedAt           DateTime?
  createdAt           DateTime @default(now())

  batch FinanceDataBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([invDate])
  @@index([seller])
  @@index([status])
  @@index([matchStatus])
  @@index([matchedContractId])
  @@map("invoice_records")
}

model AiUsageLog {
  id        String   @id @default(uuid())
  userId    String
  userName  String?
  action    String   // CHAT / PARSE / AGENT / HS_CODE
  model     String   // kimi-k2-turbo-preview / gpt-4 / etc
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  totalTokens     Int      @default(0)
  durationMs  Int        @default(0)
  status      String     // SUCCESS / ERROR
  errorMessage String?
  metadata    String?    // JSON string
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("ai_usage_logs")
}
