# 数据库配置（SQLite）。生产库使用绝对路径，且目录权限 0700、文件 0600
DATABASE_URL="file:./dev.db"

# JWT配置
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# 默认管理员密码（用于 prisma seed）
# 强烈建议设置一个高强度密码；若未设置，seed 将使用测试默认密码 123456
DEFAULT_ADMIN_PASSWORD="ChangeThis-Strong-Password"

# 服务器配置
PORT=3000
NODE_ENV=development

# Kimi API配置（必填 - 需要有效的API Key才能使用AI功能）
# 获取方式：https://platform.moonshot.cn/
KIMI_API_KEY="your-kimi-api-key"
KIMI_BASE_URL="https://api.moonshot.cn/v1"

# HSCIQ API 配置（海关编码智能查询服务，测试期每天 150 次调用限制）
# 获取方式：https://www.hsciq.com/MCP/List
HSCIQ_API_KEY="your-hsciq-api-key"
HSCIQ_BASE_URL="https://www.hsciq.com/mcp"

# 文件上传配置
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=52428800

# 跨域白名单（按逗号分隔）
CORS_ORIGIN="http://localhost:3000"

# 库存预警任务配置（每日定时扫描）
INVENTORY_ALERT_SCHEDULE_HOUR=9
INVENTORY_ALERT_SCHEDULE_MINUTE=0
INVENTORY_ALERT_RUN_ON_START=true

# Agent 凭证预警任务配置（每日定时扫描）
AGENT_CREDENTIAL_ALERT_SCHEDULE_HOUR=10
AGENT_CREDENTIAL_ALERT_SCHEDULE_MINUTE=0
AGENT_CREDENTIAL_ALERT_RUN_ON_START=true
