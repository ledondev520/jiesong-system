# 数据库配置（Supabase PostgreSQL）
# DATABASE_URL：连接池 URL，用于运行时查询（Transaction Mode，端口 6543）
# 格式：postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL：直连 URL，仅供 prisma migrate / db push 使用（端口 5432）
# 格式：postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# 旧 SQLite 配置（已废弃，迁移到 Supabase 后删除）
# DATABASE_URL="file:./dev.db"

# JWT配置
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# 默认管理员密码（用于 prisma seed）
# 强烈建议设置一个高强度密码；若未设置，seed 将使用测试默认密码 123456
DEFAULT_ADMIN_PASSWORD="ChangeThis-Strong-Password"

# 服务器配置
PORT=3000
NODE_ENV=development

# Kimi API配置（必填 - 需要有效的API Key才能使用AI功能）
# 获取方式：https://platform.moonshot.cn/
KIMI_API_KEY="your-kimi-api-key"
KIMI_BASE_URL="https://api.moonshot.cn/v1"

# 文件上传配置
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=52428800

# 跨域白名单（按逗号分隔）
CORS_ORIGIN="http://localhost:3000"

# 库存预警任务配置（每日定时扫描）
INVENTORY_ALERT_SCHEDULE_HOUR=9
INVENTORY_ALERT_SCHEDULE_MINUTE=0
INVENTORY_ALERT_RUN_ON_START=true
